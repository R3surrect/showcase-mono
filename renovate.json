{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
"extends": [
    "config:recommended",
    "group:monorepos",
    ":separateMajorReleases"
  ],
  "enabledManagers": ["npm"],
  "timezone": "Europe/Moscow",
  "schedule": ["before 8am on monday"],
  "packageRules": [
    {
      "groupName": "linters and formatters",
      "matchPackageNames": ["eslint*", "prettier*"],
      "automerge": false
    }
  ]
}