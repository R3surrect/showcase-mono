        {
            "label": "docker",
            "type": "shell",
            "command": "sleep 1 && clear && start \"\" \"C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe\" -headless && until docker info >/dev/null 2>&1; do sleep 2; done; cd packages/backend && docker compose up -d && docker compose logs -f --tail=100 || read",
            "problemMatcher": [],
