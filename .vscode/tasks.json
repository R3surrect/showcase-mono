{
    "version": "2.0.0",
    "options": {
        "shell": {
            "executable": "fish",
            "args": ["-c"] 
        }
    },
    "tasks": [
        {
            "label": "pnpm",
            "type": "shell",
            "command": "clear && pnpm -w run dev:all",
            "problemMatcher": [],
            "presentation": {
                "group": "dev-group",
                "panel": "dedicated"
            },
            "icon": {
                "id": "play-circle",
                "color": "terminal.ansiMagenta"
            }
        },
        {
            "label": "docker",
            "type": "shell",
            "command": "systemctl start docker && until docker info >/dev/null 2>&1; do sleep 2; done; cd packages/backend && docker compose up -d && docker compose logs -f --tail=100 || read",
            "problemMatcher": [],
            "presentation": {
                "group": "dev-group",
                "panel": "dedicated"
            },
            "icon": {
                "id": "server-process",
                "color": "terminal.ansiYellow"
            }
        },
        {
            "label": "git",
            "type": "shell",
            "command": "sleep 2 && clear && fish",
            "problemMatcher": [],
            "presentation": {
                "group": "dev-group",
                "panel": "dedicated"
            },
            "icon": {
                "id": "github",
                "color": "terminal.ansiGreen"
            }
        },
