                "group": "dev-group",
                "panel": "dedicated"
            },
            "icon": {
                "id": "server-process",
                "color": "terminal.ansiYellow"
            }
        },
        {
            "label": "git",
            "type": "shell",
            "command": "sleep 2 && clear && exec bash",
            "problemMatcher": [],
